---
import { Image } from 'astro:assets';
import SearchBar from '../Common/SearchBar';
import MainContainer from '../Main/MainContainer';
import Menu from './Menu';
import FollowCard from './FollowCard';
import SmallRatLogo from '../../assets/imagenes/ratas/SmallRat.webp';

const userData = {
  username: "Username",
  followers: 137,
  following: 547
};
---
<header   
  class="fixed top-0 left-0 right-0 z-[10000] flex h-16 items-center justify-center bg-background shadow-[0_4px_8px_0_rgba(0,0,0,0.8)]" 
>   
  <MainContainer>
    <div class="grid grid-cols-[auto_1fr_auto] gap-2 md:gap-4 lg:gap-6 items-center w-full">
      
      {/* Logo + Botón Menú */}
      <div class="flex items-center gap-2">
        <button
          id="menu-btn"
          class="lg:hidden flex items-center justify-center p-2 rounded-lg transition-all bg-unselect shadow-[0_2px_4px_rgba(0,0,0,0.6)] hover:brightness-110 hover:scale-105"
          aria-label="Abrir menú"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="text-white">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
              <path d="M3 12h18M3 6h18M3 18h18"/>
            </g>
          </svg>
        </button>

        <a href="/" aria-label="Ir a inicio" class="flex items-center gap-1 md:gap-2 no-underline">       
          <Image src={SmallRatLogo} alt="Logo" class="h-8 w-8 md:h-10 md:w-10" width={40} height={40} loading="eager" />       
          <span class="default-font text-white text-lg md:text-2xl lg:text-4xl xl:text-5xl font-bold hidden sm:block">ForoRata</span>     
        </a>
      </div>

      {/* SearchBar */}
      <div class="flex justify-center min-w-0">
        <div class="w-full max-w-[200px] sm:max-w-[280px] md:max-w-[400px] lg:max-w-[500px] xl:max-w-[614px]">
          <SearchBar client:load />
        </div>
      </div>

      {/* Usuario + Botón Seguidores */}
      <div class="flex items-center justify-end gap-2">
        <span class="default-font text-white text-xs sm:text-sm md:text-base lg:text-lg font-medium whitespace-nowrap">
          Hola, {userData.username}
        </span>
        <button
          id="followers-btn"
          class="lg:hidden flex items-center justify-center p-2 rounded-lg transition-all bg-unselect shadow-[0_2px_4px_rgba(0,0,0,0.6)] hover:brightness-110 hover:scale-105"
          aria-label="Ver seguidores"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" class="text-white">
            <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
              <path d="M5 7a4 4 0 1 0 8 0a4 4 0 1 0-8 0M3 21v-2a4 4 0 0 1 4-4h4a4 4 0 0 1 4 4v2m1-17.87a4 4 0 0 1 0 7.75M21 21v-2a4 4 0 0 0-3-3.85"/>
            </g>
          </svg>
        </button>
      </div>
    </div>
  </MainContainer>
</header>

{/* Paneles móviles */}
<div id="menu-panel" class="lg:hidden fixed top-0 left-0 h-full w-80 bg-background shadow-[5px_0_15px_rgba(0,0,0,0.9)] z-[10002] -translate-x-full transition-transform duration-300">
  <div class="p-6 h-full overflow-y-auto">
    <div class="flex justify-between items-center mb-6 pb-4 border-b border-gray-600">
      <h3 class="text-xl font-bold text-white">Menú</h3>
      <button id="close-menu" class="text-white text-2xl hover:text-gray-300" aria-label="Cerrar">×</button>
    </div>
    <Menu client:load userData={JSON.stringify(userData)} />
  </div>
</div>

<div id="followers-panel" class="lg:hidden fixed top-0 right-0 h-full w-80 bg-background shadow-[-5px_0_15px_rgba(0,0,0,0.9)] z-[10002] translate-x-full transition-transform duration-300">
  <div class="p-6 h-full overflow-y-auto">
    <div class="flex justify-between items-center mb-6 pb-4 border-b border-gray-600">
      <h3 class="text-xl font-bold text-white">Últimos Seguidores</h3>
      <button id="close-followers" class="text-white text-2xl hover:text-gray-300" aria-label="Cerrar">×</button>
    </div>
    <FollowCard client:load />
  </div>
</div>

<div id="overlay" class="lg:hidden fixed inset-0 bg-black/50 z-[10001] hidden"></div>

<script>
  const menuBtn = document.getElementById('menu-btn');
  const followersBtn = document.getElementById('followers-btn');
  const menuPanel = document.getElementById('menu-panel');
  const followersPanel = document.getElementById('followers-panel');
  const overlay = document.getElementById('overlay');
  const closeMenu = document.getElementById('close-menu');
  const closeFollowers = document.getElementById('close-followers');

  const closeAll = () => {
    menuPanel?.classList.add('-translate-x-full');
    followersPanel?.classList.add('translate-x-full');
    overlay?.classList.add('hidden');
    menuBtn?.style.setProperty('background-color', 'var(--color-unselect)');
    followersBtn?.style.setProperty('background-color', 'var(--color-unselect)');
  };

  menuBtn?.addEventListener('click', () => {
    closeAll();
    setTimeout(() => {
      menuPanel?.classList.remove('-translate-x-full');
      overlay?.classList.remove('hidden');
      menuBtn?.style.setProperty('background-color', 'var(--color-accent2)');
    }, 50);
  });

  followersBtn?.addEventListener('click', () => {
    closeAll();
    setTimeout(() => {
      followersPanel?.classList.remove('translate-x-full');
      overlay?.classList.remove('hidden');
      followersBtn?.style.setProperty('background-color', 'var(--color-accent2)');
    }, 50);
  });

  closeMenu?.addEventListener('click', closeAll);
  closeFollowers?.addEventListener('click', closeAll);
  overlay?.addEventListener('click', closeAll);
  document.addEventListener('keydown', (e) => e.key === 'Escape' && closeAll());
</script>

<style>
  @media (max-width: 640px) {
    #menu-panel, #followers-panel { width: 90vw; max-width: 320px; }
  }
</style>